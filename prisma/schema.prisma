// Prisma schema for OpenAI Vector Stores API
// Note: PGVector types are not fully supported in Prisma, so we use Unsupported types

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VectorStore {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  file_counts  Json?
  status       String   @default("completed")
  usage_bytes  BigInt?  @default(0)
  metadata     Json?
  created_at   DateTime @default(now()) @db.Timestamptz
  expires_after Json?
  expires_at   DateTime? @db.Timestamptz
  last_active_at DateTime? @default(now()) @db.Timestamptz
  embeddings   Embedding[]
  
  @@map("vector_stores")
}

model Embedding {
  id              String      @id @default(uuid()) @db.Uuid
  vector_store_id String      @db.Uuid
  content         String
  embedding       Unsupported("vector(1536)")
  metadata        Json?
  created_at      DateTime    @default(now()) @db.Timestamptz
  
  vector_store    VectorStore @relation(fields: [vector_store_id], references: [id], onDelete: Cascade)
  
  @@map("embeddings")
  @@index([vector_store_id])
}

